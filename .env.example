SKIP_LLM=true
DEMO_USERNAME=demo
DEMO_PASSWORD=demobxyz
# Compose default is http://host.docker.internal:11434/v1 (Ollama on the host).
# Leave LLM_BASE_URL unset for Docker so that default applies. For a host venv:
# LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_ENGINE=ollama
MODEL_REASONING=gemma4:latest
MODEL_FAST=gemma4:latest
MODEL_CONTEXT_LENGTH=131072
LLM_TIMEOUT=180
LLM_READY_TIMEOUT_SECONDS=120
LOG_LEVEL=INFO
# Compose bind-mounts ./logs → /app/logs for openai-v1.log
# LOG_DIR=/app/logs
RUNS_DIR=runs
DEFAULT_PLAN=essentials
