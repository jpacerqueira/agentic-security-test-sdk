SKIP_LLM=true
DEMO_USERNAME=demo
DEMO_PASSWORD=demobxyz

# Active gateway profile: ollama (default) | lmstudio | bedrock | vertex
# Switch: change this, then `docker compose up -d llm-gateway`
LLM_PROFILE=ollama

# Compose default: app → http://llm-gateway:4000/v1 (do not set LLM_BASE_URL here).
# Host venv without the gateway:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_ENGINE=ollama
# LLM_API_KEY=ollama
LLM_API_KEY=sk-agentic-local
LLM_ENGINE=gateway
MODEL_REASONING=gemma4:latest
MODEL_FAST=gemma4:latest
MODEL_CONTEXT_LENGTH=131072
LLM_TIMEOUT=360
LLM_READY_TIMEOUT_SECONDS=120

# Ollama on the host (used only when LLM_PROFILE=ollama)
# OLLAMA_API_BASE=http://host.docker.internal:11434
# OLLAMA_LITELLM_MODEL=ollama_chat/gemma4:latest

# LM Studio (dormant). Set LLM_PROFILE=lmstudio and the loaded model id:
# LMSTUDIO_API_BASE=http://host.docker.internal:1234/v1
# LMSTUDIO_LITELLM_MODEL=openai/your-loaded-model

# AWS Bedrock (dormant). Set LLM_PROFILE=bedrock plus keys/region:
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# BEDROCK_LITELLM_MODEL=bedrock/anthropic.claude-3-5-sonnet-20241022-v2:0

# Vertex AI Gemini (dormant). Set LLM_PROFILE=vertex, project, and mount gcp-sa.json:
# GOOGLE_CLOUD_PROJECT=
# VERTEX_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp-sa.json
# VERTEX_LITELLM_MODEL=vertex_ai/gemini-2.0-flash

LOG_LEVEL=INFO
LITELLM_LOG=DEBUG
# Compose bind-mounts ./logs → /app/logs
#   openai-v1.log          app /v1 calls (started_at, ended_at, duration_ms)
#   agentic-security.log   app package log, same UTC clock
#   llm-gateway.log        JSON timeframes (call_start, duration_ms, upstream_ms)
# LOG_DIR=/app/logs
RUNS_DIR=runs
DEFAULT_PLAN=essentials
